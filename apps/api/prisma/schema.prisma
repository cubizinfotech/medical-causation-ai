// Medical Causation AI + Expert Witness Investigation
// Indexing schema (documents + vectors) + MCA cases + EWI investigations
// pgvector embedding column is created via migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["documents", "vectors", "cases", "ewi", "platform"]
}

enum IndexStatus {
  pending
  processing
  indexed
  failed
  skipped

  @@schema("documents")
}

/// Product corpus: mca | ewi — keeps knowledge indexes separated.
enum ProductCorpus {
  mca
  ewi

  @@schema("documents")
}

model IndexedDocument {
  id                  String        @id @default(uuid()) @db.Uuid
  knowledgeDocumentId String        @unique @map("knowledge_document_id")
  documentTitle       String        @map("document_title")
  filename            String
  relativePath        String        @map("relative_path")
  sourceFile          String        @map("source_file")
  category            String
  subCategory         String?       @map("sub_category")
  extension           String
  checksum            String
  fileSize            BigInt        @map("file_size")
  fileModifiedAt      DateTime      @map("file_modified_at")
  pageCount           Int           @default(0) @map("page_count")
  chunkCount          Int           @default(0) @map("chunk_count")
  product             ProductCorpus @default(mca)
  status              IndexStatus   @default(pending)
  errorMessage        String?       @map("error_message")
  indexedAt           DateTime?     @map("indexed_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@index([status])
  @@index([checksum])
  @@index([product])
  @@map("indexed_documents")
  @@schema("documents")
}

model DocumentChunk {
  id              String   @id @default(uuid()) @db.Uuid
  externalChunkId String   @unique @map("external_chunk_id")
  documentId      String   @map("document_id") @db.Uuid
  chunkIndex      Int      @map("chunk_index")
  totalChunks     Int      @map("total_chunks")
  pageNumber      Int?     @map("page_number")
  section         String?
  text            String
  estimatedTokens Int      @map("estimated_tokens")
  contentHash     String   @map("content_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  document  IndexedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding ChunkEmbedding?

  @@unique([documentId, chunkIndex])
  @@unique([documentId, contentHash])
  @@map("document_chunks")
  @@schema("documents")
}

model ChunkEmbedding {
  id         String   @id @default(uuid()) @db.Uuid
  chunkId    String   @unique @map("chunk_id") @db.Uuid
  provider   String
  model      String
  dimensions Int
  createdAt  DateTime @default(now()) @map("created_at")

  chunk DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("chunk_embeddings")
  @@schema("vectors")
}

enum AnalysisCaseStatus {
  queued
  running
  completed
  failed

  @@schema("cases")
}

model AnalysisCase {
  id                  String             @id @default(uuid()) @db.Uuid
  jobId               String             @unique @map("job_id")
  /// Kept for rows created before names were removed. New cases store an empty string. Not returned by the API.
  patientName         String             @map("patient_name")
  patientAge          String             @map("patient_age")
  patientGender       String             @map("patient_gender")
  accidentDate        String             @map("accident_date")
  accidentType        String             @map("accident_type")
  accidentDescription String             @map("accident_description")
  diagnosis           String
  symptoms            String
  medicalHistory      String?            @map("medical_history")
  medications         String?
  timeline            String?
  medicalQuestion     String             @map("medical_question")
  status              AnalysisCaseStatus @default(queued)
  step                String?
  stepLabel           String?            @map("step_label")
  progress            Int                @default(0)
  message             String?
  errorMessage        String?            @map("error_message")
  result              Json?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  completedAt         DateTime?          @map("completed_at")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("analysis_cases")
  @@schema("cases")
}

enum InvestigationStatus {
  pending
  running
  completed
  failed
  cancelled

  @@schema("ewi")
}

enum VerificationStatus {
  unverified
  verified
  disputed

  @@schema("ewi")
}

/// Evidence label for an inconsistency. These names do not assert fraud.
enum InconsistencyLabel {
  verified
  partially_verified
  conflicting
  not_verified
  not_found
  unable_to_verify

  @@schema("ewi")
}

/// Whether a research item's content was stored.
/// metadata_only means the license does not permit storing the body.
enum EvidenceStatus {
  recorded
  metadata_only
  unavailable

  @@schema("ewi")
}

/// Classification of a collected research item.
/// Inconsistencies stay on discrepancies. Questions stay on cross_exam_questions.
/// The generated Word file stays on investigation_reports.
enum EwiEvidenceCategory {
  identity_profile
  location
  specialty
  cv
  education
  university
  license
  state_license
  board_certification
  certification_organization
  membership
  publication
  grant
  patent
  award
  military
  legal_case
  court_order
  motion
  deposition
  testimony
  directory
  website
  ime
  advertising
  video
  presentation
  powerpoint
  social
  news
  university_rules
  income_bias
  patient_review
  office
  corporate_affiliation
  criminal_record
  malpractice
  foia_request
  university_request
  graduation_request
  research_finding

  @@schema("ewi")
}

model Expert {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String
  specialty String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  investigations Investigation[]

  @@unique([name, city, specialty])
  @@index([name])
  @@index([city])
  @@index([specialty])
  @@map("experts")
  @@schema("ewi")
}

model Investigation {
  id            String              @id @default(uuid()) @db.Uuid
  expertId      String              @map("expert_id") @db.Uuid
  jobId         String              @unique @map("job_id")
  status        InvestigationStatus @default(pending)
  currentStage  String?             @map("current_stage")
  stageLabel    String?             @map("stage_label")
  progress      Int                 @default(0)
  message       String?
  errorMessage  String?             @map("error_message")
  notes         String?
  startedAt     DateTime?           @map("started_at")
  completedAt   DateTime?           @map("completed_at")
  cancelledAt   DateTime?           @map("cancelled_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  expert        Expert              @relation(fields: [expertId], references: [id])
  profile       ExpertProfile?
  sources       ResearchSource[]
  findings      ResearchFinding[]
  discrepancies Discrepancy[]
  questions     CrossExamQuestion[]
  report        InvestigationReport?
  analysis      InvestigationAnalysis?
  events        InvestigationEvent[]
  requests      InvestigationRequest[]

  @@index([status])
  @@index([expertId])
  @@index([createdAt(sort: Desc)])
  @@map("investigations")
  @@schema("ewi")
}

model ExpertProfile {
  id              String   @id @default(uuid()) @db.Uuid
  investigationId String   @unique @map("investigation_id") @db.Uuid
  displayName     String   @map("display_name")
  city            String
  specialty       String
  summary         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([city])
  @@map("expert_profiles")
  @@schema("ewi")
}

model ResearchSource {
  id              String         @id @default(uuid()) @db.Uuid
  investigationId String         @map("investigation_id") @db.Uuid
  sourceType      String         @map("source_type")
  provider        String
  name            String
  url             String?
  publishedAt     DateTime?      @map("published_at")
  retrievedAt     DateTime?      @map("retrieved_at")
  evidenceStatus  EvidenceStatus @default(recorded) @map("evidence_status")
  restricted      Boolean        @default(false)
  restrictionNote String?        @map("restriction_note")
  createdAt       DateTime       @default(now()) @map("created_at")

  investigation Investigation     @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  findings      ResearchFinding[]

  @@index([investigationId])
  @@index([provider])
  @@index([evidenceStatus])
  @@map("research_sources")
  @@schema("ewi")
}

model ResearchFinding {
  id                 String              @id @default(uuid()) @db.Uuid
  investigationId    String              @map("investigation_id") @db.Uuid
  sourceId           String              @map("source_id") @db.Uuid
  category           EwiEvidenceCategory
  title              String
  summary            String?
  url                String?
  sourceType         String              @map("source_type")
  sourceName         String              @map("source_name")
  publishedAt        DateTime?           @map("published_at")
  retrievedAt        DateTime?           @map("retrieved_at")
  relevantDates      DateTime[]          @default([]) @map("relevant_dates")
  evidenceStatus     EvidenceStatus      @default(recorded) @map("evidence_status")
  verificationStatus VerificationStatus  @default(unverified) @map("verification_status")
  restricted         Boolean             @default(false)
  notes              String?
  /// Category-specific fields. Omitted when the source license forbids storing content.
  attributes         Json?
  createdAt          DateTime            @default(now()) @map("created_at")

  investigation Investigation  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  source        ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([investigationId, category])
  @@index([category])
  @@index([verificationStatus])
  @@index([evidenceStatus])
  @@map("research_findings")
  @@schema("ewi")
}

model Discrepancy {
  id                 String              @id @default(uuid()) @db.Uuid
  investigationId    String              @map("investigation_id") @db.Uuid
  severity           String
  title              String
  description        String
  relatedUrls        String[]            @default([]) @map("related_urls")
  sourceType         String?             @map("source_type")
  sourceName         String?             @map("source_name")
  sourceUrl          String?             @map("source_url")
  retrievedAt        DateTime?           @map("retrieved_at")
  relevantDates      DateTime[]          @default([]) @map("relevant_dates")
  evidenceStatus     EvidenceStatus      @default(recorded) @map("evidence_status")
  verificationStatus VerificationStatus  @default(unverified) @map("verification_status")
  label              InconsistencyLabel  @default(not_verified)
  field              String?
  previousValue      String?             @map("previous_value") @db.Text
  currentValue       String?             @map("current_value") @db.Text
  changeText         String?             @map("change_text") @db.Text
  cvDate             String?             @map("cv_date")
  cvSource           String?             @map("cv_source")
  supportingSource   String?             @map("supporting_source")
  priority           Int                 @default(100)
  /// Source statements compared for this inconsistency.
  evidence           Json?
  restricted         Boolean             @default(false)
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([investigationId, priority])
  @@index([label])
  @@index([evidenceStatus])
  @@map("discrepancies")
  @@schema("ewi")
}

model CrossExamQuestion {
  id              String   @id @default(uuid()) @db.Uuid
  investigationId String   @map("investigation_id") @db.Uuid
  number          Int
  category        String
  question        String
  evidenceBasis   String   @map("evidence_basis")
  createdAt       DateTime @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId, number])
  @@map("cross_exam_questions")
  @@schema("ewi")
}

model InvestigationReport {
  id              String   @id @default(uuid()) @db.Uuid
  investigationId String   @unique @map("investigation_id") @db.Uuid
  fileName        String   @map("file_name")
  mimeType        String   @map("mime_type")
  storageKey      String   @map("storage_key")
  byteSize        Int      @map("byte_size")
  templateId      String   @default("ewi/investigation-report") @map("template_id")
  templateVersion String   @default("1.0.0") @map("template_version")
  generatedAt     DateTime @map("generated_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@map("investigation_reports")
  @@schema("ewi")
}

model InvestigationAnalysis {
  id              String   @id @default(uuid()) @db.Uuid
  investigationId String   @unique @map("investigation_id") @db.Uuid
  origin          String
  providerName    String?  @map("provider_name")
  schemaVersion   String   @map("schema_version")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@map("investigation_analyses")
  @@schema("ewi")
}

model InvestigationEvent {
  id              String               @id @default(uuid()) @db.Uuid
  investigationId String               @map("investigation_id") @db.Uuid
  eventType       String               @map("event_type")
  status          InvestigationStatus?
  stage           String?
  message         String?
  createdAt       DateTime             @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
  @@map("investigation_events")
  @@schema("ewi")
}

enum InvestigationRequestType {
  foia
  university_file
  graduation_announcement
  university_employment
  follow_up
  trialsmith

  @@schema("ewi")
}

enum InvestigationRequestStatus {
  draft
  pending_approval
  approved
  queued
  sent
  logged_not_sent
  failed
  cancelled
  needs_manual_review

  @@schema("ewi")
}

/// Prepared or sent FOIA / university / outreach request for an investigation.
/// Recipient addresses and credentials are never hardcoded; they come from
/// configuration or per-request input. Passwords are never stored here.
model InvestigationRequest {
  id                 String                       @id @default(uuid()) @db.Uuid
  investigationId    String                       @map("investigation_id") @db.Uuid
  requestType        InvestigationRequestType     @map("request_type")
  status             InvestigationRequestStatus   @default(draft)
  organizationName   String                       @map("organization_name")
  recipientEmail     String?                      @map("recipient_email")
  recipientName      String?                      @map("recipient_name")
  subject            String
  bodyText           String                       @map("body_text") @db.Text
  templateId         String                       @map("template_id")
  caseReference      String                       @map("case_reference")
  followUpAt         DateTime?                    @map("follow_up_at")
  parentRequestId    String?                      @map("parent_request_id") @db.Uuid
  approvedAt         DateTime?                    @map("approved_at")
  approvedBy         String?                      @map("approved_by")
  sentAt             DateTime?                    @map("sent_at")
  provider           String?
  providerMessageId  String?                      @map("provider_message_id")
  delivered          Boolean                      @default(false)
  errorMessage       String?                      @map("error_message") @db.Text
  /// Structured generation fields. No credentials.
  metadata           Json?
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  investigation Investigation          @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  parentRequest InvestigationRequest?  @relation("RequestFollowUps", fields: [parentRequestId], references: [id], onDelete: SetNull)
  followUps     InvestigationRequest[] @relation("RequestFollowUps")

  @@index([investigationId])
  @@index([investigationId, requestType])
  @@index([status])
  @@index([followUpAt])
  @@map("investigation_requests")
  @@schema("ewi")
}

enum PlatformRoleName {
  super_admin
  admin
  attorney
  paralegal
  medical_expert
  user

  @@schema("platform")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  displayName  String     @map("display_name")
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  roles        UserRole[]

  @@map("users")
  @@schema("platform")
}

model Role {
  id    String           @id @default(uuid()) @db.Uuid
  name  PlatformRoleName @unique
  users UserRole[]

  @@map("roles")
  @@schema("platform")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("platform")
}
