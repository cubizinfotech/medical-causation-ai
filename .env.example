# =============================================================================
# Medical Causation AI — example configuration (committed; no real secrets)
#
#   Local:   cp .env.example .env
#            then set JWT_SECRET (openssl rand -hex 32) and any AI keys you use
#   Server:  start from .env.live (see DEPLOYMENT.md). Never copy this file
#            over a working production .env.
#
# Values here are placeholders or safe development defaults. The API, website,
# Prisma, Docker Compose, and PM2 read the repository-root `.env`.
# A setting that is omitted uses the code default shown in the comment.
# Never put real keys, passwords, or tokens in this file.
# =============================================================================


# =============================================================================
# 1. Core application and database
# Required for the API to start and accept browser requests.
# =============================================================================

# development | production
NODE_ENV=development

# Browser → API address. Built into the website by `npm run build:web`, so
# rebuild after changing it. Production: https://<API_DOMAIN>
NEXT_PUBLIC_API_URL=http://localhost:3001
# Website address(es) the API accepts requests from (CORS). Comma-separated.
FRONTEND_URL=http://localhost:3000
# The API's own public address (links, health, CORS helpers).
API_PUBLIC_URL=http://localhost:3001

# Signs login tokens. Required: at least 32 random characters.
#   openssl rand -hex 32
JWT_SECRET=
# How long a sign-in lasts (e.g. 8h, 12h, 1d).
JWT_EXPIRES_IN=12h

# PostgreSQL. Compose creates the database from POSTGRES_*; the API and
# Prisma connect with DATABASE_URL (use 127.0.0.1 for processes on the host).
POSTGRES_USER=mca_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medical_causation_ai
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost
DATABASE_URL=postgresql://mca_user:change-me@127.0.0.1:5432/medical_causation_ai
# DATABASE_SSL=false
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Display name on /health (optional).
# APP_NAME=Medical Causation AI API


# =============================================================================
# 2. Redis and infrastructure
# Required for job queues and investigation/analysis progress.
# =============================================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set a password on any server; the Redis container then requires it.
REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=mca:
# Or one URL instead of the host/port/password values above:
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# Optional database browser. 127.0.0.1 = this machine only.
# 0.0.0.0 = also reachable as http://<this-machine-ip>:5050.
PGADMIN_BIND=127.0.0.1
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050


# =============================================================================
# 3. AI providers and model configuration
# Required for MCA analysis wording and EWI CV claim reading / question polish.
# Fill the key for AI_PROVIDER (and AI_FALLBACK_PROVIDER if set).
# =============================================================================

# openrouter | openai | anthropic | gemini | groq | mistral
AI_PROVIDER=gemini
# Optional second provider when the main one refuses a call (rate limit,
# no credits, bad key, outage). Needs its own key. Leave empty for none.
AI_FALLBACK_PROVIDER=
# Optional: one model name for whichever provider is active.
# AI_CHAT_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_DELAY_MS=5000
AI_REQUEST_TIMEOUT_MS=120000
# Token accounting / cost display (optional; 0 = not reported):
# AI_MAX_PROMPT_TOKENS=128000
# AI_MAX_COMPLETION_TOKENS=4096
# AI_MAX_TOTAL_TOKENS=131072
# AI_COST_PER_1K_PROMPT_TOKENS_USD=0
# AI_COST_PER_1K_COMPLETION_TOKENS_USD=0

# Fill in the key for the provider you use. Model names are per provider.
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=mistral-small-latest

ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher is more thorough and slower.
ANTHROPIC_EFFORT=high
# Thinking counts toward this limit; only tokens generated are billed.
ANTHROPIC_MAX_TOKENS=32000
# Only for a key that is not scoped to a workspace.
# ANTHROPIC_WORKSPACE_ID=

GEMINI_API_KEY=
# Alias accepted if GEMINI_API_KEY is empty:
# GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_PROJECT_ID=
# GEMINI_USE_ENTERPRISE=false

OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=openai/gpt-4o

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
# OPENAI_ORGANIZATION=

GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Azure OpenAI (optional; not used unless AI_PROVIDER is wired to it)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Provider addresses only change for a proxy or a self-hosted gateway:
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1


# =============================================================================
# 4. Embeddings and vector search (MCA medical library)
# Required to index/search knowledge-base files. After changing provider or
# model, run: npm run reembed:kb
# =============================================================================

# openai | openrouter | gemini | voyage | jina | nomic | ollama
# (Anthropic and Groq have no embeddings.) Changing EMBEDDING_DIMENSIONS
# also needs a database migration.
EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_RETRY_MAX_ATTEMPTS=3
EMBEDDING_REQUEST_TIMEOUT_MS=30000
EMBEDDING_RETRY_DELAY_MS=1000
# EMBEDDING_BATCH_DELAY_MS=0
# Gemini embedding call size (default 16, max 100) and pause between calls:
# GEMINI_EMBED_BATCH_SIZE=16
# GEMINI_EMBED_ITEM_DELAY_MS=100
# VOYAGE_API_KEY=
# JINA_API_KEY=
# NOMIC_API_KEY=
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Library text given to the AI per analysis. Lower it for providers with
# small per-minute token limits.
RAG_MAX_CONTEXT_TOKENS=8000
# Fine-tuning (defaults shown):
# RAG_TOP_K=10
# RAG_VECTOR_TOP_K=20
# RAG_KEYWORD_TOP_K=20
# RAG_VECTOR_WEIGHT=0.7
# RAG_KEYWORD_WEIGHT=0.3
# RAG_MIN_SIMILARITY_SCORE=0.25
# RAG_RRF_K=60
# RAG_RERANKER=score
# A library passage counts as relevant to the case from this similarity.
# Empty: set per embedding model (gemini-embedding 0.75, text-embedding-3
# 0.45). With fewer than RAG_MIN_RELEVANT_CHUNKS relevant passages, the
# analysis is supplemented with PubMed abstracts and clearly labelled AI
# reasoning instead of resting on the library alone.
# RAG_RELEVANCE_MIN_SIMILARITY=
# RAG_MIN_RELEVANT_CHUNKS=3
# RAG_HNSW_EF_SEARCH=100
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64
# CHUNK_MIN_SIZE_TOKENS=50


# =============================================================================
# 5. File storage, document processing, and OCR
# =============================================================================

# Medical books and articles (not in Git). Relative paths start at the repo root.
KNOWLEDGE_BASE_PATH=./knowledge-base
# Optional product-specific roots (otherwise KNOWLEDGE_BASE_PATH is used):
# KNOWLEDGE_BASE_MCA_PATH=
# KNOWLEDGE_BASE_EWI_PATH=
# KNOWLEDGE_BASE_BOOKS_PATH=
# KNOWLEDGE_BASE_ARTICLES_PATH=
# KNOWLEDGE_BASE_REPORTS_PATH=
# KNOWLEDGE_BASE_TEMPLATES_PATH=
# KNOWLEDGE_BASE_UPLOADS_PATH=
# KNOWLEDGE_BASE_MAX_FILE_SIZE_MB=500
# STORAGE_DRIVER=local
# UPLOAD_DIR=

# Scanned library PDFs (pages without a text layer) are read with OCR on
# this server while indexing: tesseract (default) or disabled.
# OCR_PROVIDER=tesseract
# OCR_AUTO=true
# OCR_MAX_PAGES=500
# OCR_DPI=200
# PDFs over 8 MB are indexed in their own process. 768 MB fits a 2 GB server.
# INDEX_CHILD_HEAP_MB=768

# Largest upload (MB) for medical records and CVs.
UPLOAD_MAX_SIZE_MB=50
# Client medical records (patient data) and expert CVs. Outside the web root.
CASE_RECORDS_PATH=./data/case-records
EWI_DOCUMENTS_PATH=./data/ewi-documents

# Prompt template overrides (optional; the packaged templates are used if empty):
# PROMPT_TEMPLATES_DIR=
# PROMPT_DEFAULT_VERSION=1.0.0
# PROMPT_CACHE_ENABLED=true
# PROMPT_CACHE_TTL_SECONDS=3600
# MEDICAL_PROMPTS_DIR=


# =============================================================================
# 6. MCA-specific configuration
# =============================================================================

# Per analysis: most files and total pages.
MCA_RECORDS_MAX_FILES=10
MCA_RECORDS_MAX_PAGES=200
# Uploads never attached to an analysis are deleted after this many hours.
MCA_RECORDS_STAGED_TTL_HOURS=24
# Read scanned pages with OCR on this server (nothing is sent elsewhere).
MCA_RECORDS_OCR=true
MCA_RECORDS_OCR_DPI=200
# OCR pages below this confidence (0–100) are flagged in the report.
MCA_RECORDS_OCR_LOW_CONFIDENCE=60
# Characters of record text per chronology AI call, and in the final prompt.
CHRONOLOGY_BATCH_CHARS=12000
CHRONOLOGY_PROMPT_CHARS=10000
# Output budget for the causation analysis (a full answer is 3,000–6,000 tokens).
# MCA_ANALYSIS_MAX_TOKENS=8192

# Search PubMed for published studies in each report (only medical terms
# are sent, never patient details). Optional: a free NCBI key raises the
# limit from 3 to 10 requests/second.
FEATURE_LITERATURE_SEARCH=true
PUBMED_API_KEY=
PUBMED_EMAIL=
# PUBMED_TOOL=medical-causation-ai
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
LITERATURE_MAX_RESULTS=8
LITERATURE_RESULTS_PER_QUERY=20
LITERATURE_REQUEST_TIMEOUT_MS=15000


# =============================================================================
# 7. EWI research providers and registries
# mock = sample data (safe local default). live = connected public sources.
# Do not set live unless you intend outbound public-registry HTTP.
# =============================================================================

RESEARCH_PROVIDER=mock
RESEARCH_REQUEST_TIMEOUT_MS=20000
RESEARCH_RETRY_MAX_ATTEMPTS=3
RESEARCH_RETRY_DELAY_MS=1000
# Minimum gap between calls to the same provider, in ms. 0 = no extra delay.
RESEARCH_MIN_INTERVAL_MS=0
# In-memory reuse of a just-completed source result (seconds).
# RESEARCH_CACHE_TTL_SECONDS=300

# Optional CourtListener token: search works without it; quoting opinion
# text is more reliable with a free token from courtlistener.com.
COURTLISTENER_API_TOKEN=
COURTLISTENER_TIMEOUT_MS=60000

# Optional OpenAlex polite pool key / contact. The free API works without them.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Optional Crossref polite contact. If empty, OPENALEX_MAILTO or PUBMED_EMAIL
# is sent. Not a paid key; Crossref still runs without it.
CROSSREF_MAILTO=

# Optional ORCID Public API client. Search and public record reads need both.
# Register free at https://orcid.org/developer-tools (Developer Tools).
# Without them ORCID is reported as not configured and no request is sent.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# CMS Open Payments program years to total (newest first).
OPEN_PAYMENTS_YEARS=7

# Uploaded CV: most pages, and characters per claim-reading AI call.
EWI_CV_MAX_PAGES=80
EWI_CV_BATCH_CHARS=12000
# Output budget for AI wording of the EWI report.
# EWI_ANALYSIS_MAX_TOKENS=24576

# Future LexisNexis order/motion PDFs. Keep off until the client confirms
# storage is legally permitted. Setting this to true stores licensed PDFs.
# LEXIS_STORAGE_ENABLED=false


# =============================================================================
# 8. EWI public-web search providers
# Unconfigured paid keys are skipped and reported as not configured.
# They are not treated as empty searches. Leave keys empty unless you have
# an account you intend to use.
# =============================================================================

# Search providers, in order. gemini_grounding uses GEMINI_API_KEY (no extra
# key). google_news_rss and gdelt need no key. serper | brave | tavily are
# optional paid/free-tier keys.
WEB_SEARCH_PROVIDERS=gemini_grounding,serper,brave,tavily,google_news_rss,gdelt
# WEB_SEARCH_GEMINI_MODEL=gemini-2.5-flash
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
WEB_SEARCH_MAX_QUERIES=44
# Candidate URLs kept from search hits (code default 150 if omitted).
WEB_SEARCH_MAX_PAGES=150
WEB_SEARCH_TIMEOUT_MS=45000
WEB_FETCH_TIMEOUT_MS=15000
WEB_FETCH_MAX_PAGES=40
# When a publisher blocks bots, read the public Internet Archive copy instead.
WEB_ARCHIVE_FALLBACK=true
# Whole web run limit (the job lock is 10 minutes).
WEB_RESEARCH_DEADLINE_MS=420000


# =============================================================================
# 9. EWI correspondence and request workflow
# Off by default. The API never invents recipient addresses and does not send
# FOIA/university mail unless these flags and email delivery are both enabled.
# =============================================================================

EWI_REQUEST_WORKFLOW_ENABLED=false
EWI_REQUEST_AUTO_SEND=false
EWI_REQUEST_REQUIRE_APPROVAL=true
EWI_REQUEST_FOLLOW_UP_DAYS=14
EWI_REQUEST_TRIALSMITH_ENABLED=false
EWI_REQUEST_SENDER_NAME=Records Counsel
# Per request type. false = always manual review. Defaults are true if unset.
# EWI_REQUEST_ALLOW_FOIA=true
# EWI_REQUEST_ALLOW_UNIVERSITY=true
# EWI_REQUEST_ALLOW_GRADUATION=true
# EWI_REQUEST_ALLOW_UNIVERSITY_EMPLOYMENT=true
# EWI_REQUEST_ALLOW_FOLLOW_UP=true


# =============================================================================
# 10. Email delivery
# Off until EMAIL_DELIVERY_ENABLED=true. console = log only.
# =============================================================================

# console | smtp | resend | transactional
EMAIL_PROVIDER=console
EMAIL_DELIVERY_ENABLED=false
# Legacy alias: FEATURE_EMAIL=true also enables delivery. Prefer the flag above.
EMAIL_FROM=noreply@localhost
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
# Sends every message here instead of the real recipient (testing).
EMAIL_REDIRECT_TO=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Used only when EMAIL_PROVIDER=resend and EMAIL_DELIVERY_ENABLED=true.
RESEND_API_KEY=
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_RETRY_DELAY_MS=500
# Local test inbox: docker compose --profile mail up -d mailpit
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025


# =============================================================================
# 11. Server limits and operational settings
# =============================================================================

API_PORT=3001
WEB_PORT=3000
# API listen address (HOST). PM2 copies BIND_HOST into HOST for the API.
# 0.0.0.0 = anyone; 127.0.0.1 = only Caddy once HTTPS is on.
BIND_HOST=0.0.0.0
# HOST=0.0.0.0
# PORT=3001
# Extra hosts allowed to open the Next.js dev server (comma-separated).
# WEB_DEV_ORIGINS=
# NEXT_STANDALONE=1

# Analyses + investigations one user may start per 24 hours (0 = no limit).
JOB_DAILY_LIMIT_PER_USER=50
JOB_CONCURRENCY=1
JOB_STATE_TTL_SECONDS=14400
# How long BullMQ waits for a lock renewal before treating the job as stalled.
# This is not a maximum runtime. Live EWI often runs 15–40 minutes; OCR and
# PDF work can delay renewal, and a short lock fails the still-running job
# with "job stalled more than allowable limit".
# 1800000 = 30 minutes. Use 3600000 (60 minutes) if investigations still stall.
JOB_LOCK_MS=1800000
# Times a stalled job may be recovered. 0 = fail on the first stall.
# 1 = recover once (EWI resumes from a checkpoint).
JOB_MAX_STALLED_COUNT=1

# Caddy in front of the apps: docker compose --profile https up -d caddy
# CADDYFILE=Caddyfile.ip serves port 80 on the server IP with no domain.
# CADDYFILE=
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=

# Optional local Ollama: docker compose --profile local-ai up -d ollama
# OLLAMA_PORT=11434


# =============================================================================
# 12. Script-only and deployment settings
# Not required to start the API. Used by seed, user-create, backup, deploy.
# =============================================================================

# npm run seed:demo-users — production also needs ALLOW_DEMO_SEED=true
# and DEMO_USER_PASSWORD (any non-empty value).
# Locally the demo password is "password" unless DEMO_USER_PASSWORD is set.
# DEMO_USER_PASSWORD=
# ALLOW_DEMO_SEED=false
# npm run user:create -- <email> <role> "<Name>" — random password unless set.
# NEW_USER_PASSWORD=

# scripts/backup.sh (optional; set on the server or in cron, not in Git):
# MCA_ROOT=/var/www/medical-causation-ai
# BACKUP_DIR=/var/backups/medical-causation-ai
# BACKUP_KEEP_DAYS=14
# BACKUP_WITH_LIBRARY=1
# BACKUP_RCLONE_REMOTE=
# BACKUP_GPG_RECIPIENT=
# BACKUP_PASSPHRASE_FILE=/root/.mca-backup-passphrase
# POSTGRES_CONTAINER=mca-postgres

# scripts/deploy-production.sh:
# DEPLOY_BRANCH=main
# DEPLOY_LOCK_FILE=/tmp/mca-deploy.lock
# NVM_DIR=


# =============================================================================
# Reserved catalog labels — NOT read by the API
# These names appear on unimplemented EWI provider catalog entries. Setting
# them does not enable a source. Adapters are not implemented in this phase.
# =============================================================================
#
#   WEB_SEARCH_API_KEY          use GEMINI_API_KEY / SERPER_API_KEY /
#                               BRAVE_SEARCH_API_KEY / TAVILY_API_KEY instead
#   USPTO_API_KEY
#   LEXISNEXIS_API_KEY          also see LEXIS_STORAGE_ENABLED above
#   EXPERT_DIRECTORY_API_KEY
#   DRI_API_KEY
#   SEAK_API_KEY
#   ALM_API_KEY
#   JURISPRO_API_KEY
#   EXPERTLAW_API_KEY
#   EXPERTPAGES_API_KEY
#   EXPERTWITNESS_API_KEY
#   OTHER_DIRECTORY_API_KEY
#   ADVERTISING_DIRECTORY_API_KEY
#   IME_DIRECTORY_API_KEY
#   YOUTUBE_API_KEY
#   SOCIAL_API_KEY
#   NEWS_API_KEY
#   GOOGLE_MAPS_API_KEY
#   CRIMINAL_RECORDS_API_KEY
#   MALPRACTICE_RECORDS_API_KEY
#
