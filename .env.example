# =============================================================================
# Medical Causation AI — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# General application settings shared across services.
# -----------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# Human-readable application name displayed in logs and UI
APP_NAME=Medical Causation AI

# Public application name exposed to the browser (Next.js)
NEXT_PUBLIC_APP_NAME=Medical Causation AI

# -----------------------------------------------------------------------------
# Frontend
# Next.js web application settings.
# -----------------------------------------------------------------------------
# Port the Next.js dev/production server listens on
WEB_PORT=3000

# Public API URL — inlined at build time by Next.js (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:3001

# API request timeout in milliseconds (frontend)
NEXT_PUBLIC_API_TIMEOUT_MS=180000

# Frontend origin — used for CORS configuration on the backend
FRONTEND_URL=http://localhost:3000

# Public API URL used by the server (not a secret). Browser uses NEXT_PUBLIC_API_URL.
API_PUBLIC_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Backend
# NestJS API server settings.
# -----------------------------------------------------------------------------
# Port the NestJS API listens on
API_PORT=3001
PORT=3001

# -----------------------------------------------------------------------------
# Database
# PostgreSQL 17 with pgvector for application data and vector embeddings.
# -----------------------------------------------------------------------------
# Full connection string (overrides individual POSTGRES_* vars when set)
DATABASE_URL=postgresql://mca_user:mca_password@localhost:5432/medical_causation_ai

# Individual connection components (used when DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mca_user
POSTGRES_PASSWORD=mca_password
POSTGRES_DB=medical_causation_ai

# Enable SSL for database connections (set true in production)
DATABASE_SSL=false

# Connection pool size limits (used when ORM is added in a future phase)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# pgAdmin
# Web UI for PostgreSQL administration (Docker only).
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@medical-causation.ai
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Redis
# Used for caching, BullMQ job queues, AI task state, and session cache.
# -----------------------------------------------------------------------------
# Full Redis connection URL (overrides individual REDIS_* vars when set)
REDIS_URL=redis://localhost:6379/0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Key prefix applied to all Redis keys (prevents collisions in shared instances)
REDIS_KEY_PREFIX=mca:

# Default TTL for cached values in seconds
REDIS_TTL_SECONDS=3600
# Keep in-progress job state in Redis (seconds). JOB_STATE_TTL_SECONDS overrides this.
ANALYSIS_JOB_TTL_SECONDS=14400
JOB_STATE_TTL_SECONDS=14400

# BullMQ worker concurrency per product queue
JOB_CONCURRENCY=1

# Queue key prefixes (must match between API replicas)
# MCA_QUEUE_PREFIX={mca-bull}
# EWI_QUEUE_PREFIX={ewi-bull}

# -----------------------------------------------------------------------------
# Storage
# File storage paths for the knowledge base and user uploads.
# -----------------------------------------------------------------------------
# Root path to the private knowledge base directory (MCA default = flat layout)
KNOWLEDGE_BASE_PATH=./knowledge-base

# Optional product-scoped knowledge base roots
# MCA defaults to KNOWLEDGE_BASE_PATH (flat books/articles/... folders)
# KNOWLEDGE_BASE_MCA_PATH=./knowledge-base
# EWI defaults to ./knowledge-base/ewi
# KNOWLEDGE_BASE_EWI_PATH=./knowledge-base/ewi

# Optional per-folder path overrides (defaults to subdirectories of MCA knowledge base)
# KNOWLEDGE_BASE_BOOKS_PATH=./knowledge-base/books
# KNOWLEDGE_BASE_ARTICLES_PATH=./knowledge-base/articles
# KNOWLEDGE_BASE_REPORTS_PATH=./knowledge-base/reports
# KNOWLEDGE_BASE_TEMPLATES_PATH=./knowledge-base/templates
# KNOWLEDGE_BASE_UPLOADS_PATH=./knowledge-base/uploads

# Maximum file size for knowledge base documents in megabytes (textbooks can be large)
KNOWLEDGE_BASE_MAX_FILE_SIZE_MB=500

# Maximum upload file size in megabytes (user uploads via UI)
UPLOAD_MAX_SIZE_MB=50

# Directory for staged user uploads before ingestion
UPLOAD_DIR=./knowledge-base/uploads

# Storage driver. "local" uses the filesystem paths above.
# Object storage (S3-compatible) is not enabled. Leave these unset.
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# -----------------------------------------------------------------------------
# AI Provider Selection
# Active LLM provider: openrouter | openai | anthropic | gemini | groq
#
# Gemini (recommended — cheapest reliable option):
#   AI_PROVIDER=gemini
#   AI_CHAT_MODEL=gemini-3.5-flash-lite
#   EMBEDDING_PROVIDER=gemini
#   AI_EMBEDDING_MODEL=gemini-embedding-2
#   GEMINI_API_KEY=...  (from https://aistudio.google.com/apikey)
# -----------------------------------------------------------------------------
AI_PROVIDER=mistral

# Default temperature for AI completions (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.2

# Maximum tokens per AI completion request (lower = less rate-limit pressure on free models)
AI_MAX_TOKENS=4096

# LLM HTTP client retry settings (increase for OpenRouter free-tier demos)
AI_RETRY_MAX_ATTEMPTS=8
AI_RETRY_DELAY_MS=5000
AI_REQUEST_TIMEOUT_MS=120000

OPENROUTER_LLM_MODEL=openai/gpt-4o
OPENAI_LLM_MODEL=gpt-4o
ANTHROPIC_LLM_MODEL=claude-sonnet-4-20250514
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GROQ_LLM_MODEL=llama-3.3-70b-versatile
MISTRAL_LLM_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# OpenAI
# https://platform.openai.com/docs
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Claude (Anthropic)
# https://docs.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# -----------------------------------------------------------------------------
# Gemini (Google) — uses @google/genai SDK
# https://ai.google.dev/gemini-api/docs
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_USE_ENTERPRISE=false
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Azure OpenAI
# https://learn.microsoft.com/azure/ai-services/openai/
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -----------------------------------------------------------------------------
# OpenRouter
# https://openrouter.ai/docs — routes requests to multiple AI providers
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Groq
# https://console.groq.com/docs — fast inference for open-weight models
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# Mistral AI — OpenAI-compatible chat API
# https://docs.mistral.ai/api/
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# -----------------------------------------------------------------------------
# Embeddings
# Vector embedding models used for RAG document indexing and retrieval.
# -----------------------------------------------------------------------------
# Active embedding provider: openai | openrouter | gemini | voyage | jina | nomic | ollama | groq
EMBEDDING_PROVIDER=gemini

# Embedding model name (provider-specific)
AI_EMBEDDING_MODEL=gemini-embedding-2

# Vector dimensions — must match outputDimensionality for gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Batch size for embedding generation jobs
EMBEDDING_BATCH_SIZE=100

# Embedding HTTP client settings
EMBEDDING_RETRY_MAX_ATTEMPTS=3
EMBEDDING_REQUEST_TIMEOUT_MS=30000
EMBEDDING_RETRY_DELAY_MS=1000

# -----------------------------------------------------------------------------
# Indexing / Chunking
# Token-aware chunking for medical books and research papers.
# -----------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_SIZE_TOKENS=50

# -----------------------------------------------------------------------------
# RAG Retrieval
# Hybrid search and context preparation for LLM augmentation.
# -----------------------------------------------------------------------------
RAG_TOP_K=10
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_MAX_CONTEXT_TOKENS=8000
RAG_VECTOR_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3
RAG_MIN_SIMILARITY_SCORE=0.25
RAG_RRF_K=60
RAG_RERANKER=score

# -----------------------------------------------------------------------------
# Voyage AI Embeddings
# https://docs.voyageai.com
# -----------------------------------------------------------------------------
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# -----------------------------------------------------------------------------
# Jina AI Embeddings
# https://jina.ai/embeddings
# -----------------------------------------------------------------------------
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1

# -----------------------------------------------------------------------------
# Nomic Embeddings
# https://docs.nomic.ai
# -----------------------------------------------------------------------------
NOMIC_API_KEY=
NOMIC_BASE_URL=https://api-atlas.nomic.ai/v1

# -----------------------------------------------------------------------------
# Ollama (optional local models)
# Docker: docker compose --profile local-ai up -d ollama
# Free local embeddings/chat. Pull a model inside the container before use.
# Do not put API keys in NEXT_PUBLIC_* variables.
# -----------------------------------------------------------------------------
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434

# -----------------------------------------------------------------------------
# Prompt Management
# Configuration for loading and caching prompt templates.
# -----------------------------------------------------------------------------
# Directory containing prompt template files (auto-detected if not set)
# PROMPT_TEMPLATES_DIR=./src/ai/prompts

# Default version tag for prompt templates
PROMPT_DEFAULT_VERSION=1.0.0

# Enable in-memory prompt template caching
PROMPT_CACHE_ENABLED=true

# Prompt cache TTL in seconds (0 = no expiry)
PROMPT_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Token Limits
# Token limits and cost estimation (informational — billing not implemented).
# -----------------------------------------------------------------------------
AI_MAX_PROMPT_TOKENS=128000
AI_MAX_COMPLETION_TOKENS=4096
AI_MAX_TOTAL_TOKENS=131072

# Estimated cost per 1K tokens in USD (informational only)
AI_COST_PER_1K_PROMPT_TOKENS_USD=0
AI_COST_PER_1K_COMPLETION_TOKENS_USD=0

# -----------------------------------------------------------------------------
# Logging
# Structured application logging configuration.
# -----------------------------------------------------------------------------
# Log level: error | warn | info | debug | verbose
LOG_LEVEL=info

# Pretty-print logs in development (set false in production)
LOG_PRETTY_PRINT=true

# -----------------------------------------------------------------------------
# Feature Flags
# Toggle infrastructure features during development (all false by default).
# -----------------------------------------------------------------------------
# Enable AI processing pipelines
FEATURE_AI_PROCESSING=false

# Enable RAG document ingestion and retrieval
FEATURE_RAG=false

# Enable external medical literature search integrations
FEATURE_LITERATURE_SEARCH=false

# Enable Medical Causation Analysis product routes (default true when unset)
FEATURE_MCA=true

# Enable Expert Witness Investigation product APIs (default true when unset)
FEATURE_EWI=true

# Deliver email when true. This is the same switch as EMAIL_DELIVERY_ENABLED.
# The console provider still only logs. See docs/email.md.
FEATURE_EMAIL=false

# Enable authentication checks when a JWT module is wired (default off)
FEATURE_AUTH=false

# -----------------------------------------------------------------------------
# Email
# Business code calls the shared email service. It does not choose a vendor.
# console = log the message (local default). Nothing is transmitted.
# smtp = SMTP_* . Outside production this is allowed only for a local catch-all
#        (Mailpit). Production also needs a confirmed EMAIL_FROM.
# transactional = reserved. No vendor client is connected, so sends fail closed.
# Delivery stays off until EMAIL_DELIVERY_ENABLED=true (or FEATURE_EMAIL=true).
# Credentials belong in the environment or a secrets manager, never in source.
# Production example (do not commit real values):
#   EMAIL_PROVIDER=smtp
#   EMAIL_DELIVERY_ENABLED=true
#   EMAIL_FROM=records@your-domain.example
#   EMAIL_FROM_NAME=Records
#   EMAIL_REPLY_TO=records@your-domain.example
#   SMTP_HOST=smtp.your-provider.example
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=
#   SMTP_PASSWORD=
# Optional local inbox (still requires delivery to be enabled):
#   docker compose --profile mail up -d mailpit
#   EMAIL_PROVIDER=smtp SMTP_HOST=localhost SMTP_PORT=1025
# EMAIL_REDIRECT_TO replaces every recipient. Use it to keep mail off real orgs.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM=noreply@localhost
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
EMAIL_REDIRECT_TO=
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=500
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# -----------------------------------------------------------------------------
# Authentication
# Shared by MCA and EWI. Disabled locally so the open demo keeps working.
# Set AUTH_ENABLED=true and a local JWT_SECRET to require login.
# Demo account passwords are not stored here. See DEMO_GUIDE.md.
# Never commit a real JWT_SECRET. Do not enable the demo seed in production.
# -----------------------------------------------------------------------------
AUTH_ENABLED=false
# JWT_SECRET=
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# EWI research providers
# mock = local fixtures only (default). live = adapters that are connected.
# No live research HTTP is connected yet. Setting a key does not call that API.
# Leave every key empty for local development. Do not put secrets in the web app.
# -----------------------------------------------------------------------------
RESEARCH_PROVIDER=mock
RESEARCH_REQUEST_TIMEOUT_MS=20000
RESEARCH_RETRY_MAX_ATTEMPTS=3
RESEARCH_RETRY_DELAY_MS=1000
RESEARCH_MIN_INTERVAL_MS=0

# Optional credentials for future adapters. See docs/ewi-research-providers.md.
# WEB_SEARCH_API_KEY=
# PUBMED_API_KEY=
# ORCID_CLIENT_ID=
# CROSSREF_MAILTO=
# OPENALEX_API_KEY=
# USPTO_API_KEY=
# STATE_LICENSE_API_KEY=
# EXPERT_DIRECTORY_API_KEY=
# COURTLISTENER_API_TOKEN=
# LEXISNEXIS_API_KEY=
# YOUTUBE_API_KEY=
# NEWS_API_KEY=
# SOCIAL_API_KEY=
# IME_DIRECTORY_API_KEY=
